<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="5">
<Content>
<Paragraph Number="1" Type="Scene Heading"><Text>INT. HARBOR OFFICE - NIGHT</Text></Paragraph>
<Paragraph Type="Action"><Text>Rain on the glass. ANNA VOSS (40s) reads a file under a desk lamp.</Text></Paragraph>
<Paragraph Type="Action"><Text>THE PHONE RINGS.</Text></Paragraph>
<Paragraph Type="Character"><Text>ANNA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Voss.</Text></Paragraph>
<Paragraph Type="Character"><Text>MR. DELL (V.O.)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>They found the boat. Pier nine.</Text></Paragraph>
<Paragraph Type="Character"><Text>ANNA</Text></Paragraph>
<Paragraph Type="Parenthetical"><Text>(standing)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Who found it?</Text></Paragraph>
<Paragraph Type="Character"><Text>MR. DELL (V.O.)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Kids. Don&apos;t come alone.</Text></Paragraph>
<Paragraph Type="Character"><Text>ANNA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>NO.</Text></Paragraph>
<Paragraph Type="Transition"><Text>CUT TO:</Text></Paragraph>
<Paragraph Number="2" Type="Scene Heading"><Text>EXT. PIER NINE - CONTINUOUS</Text></Paragraph>
<Paragraph Type="Action"><Text>Wind. A rusted trawler knocks against the pilings. COP #2 holds a flashlight.</Text></Paragraph>
<Paragraph Type="Character"><Text>COP #2</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Detective. You&apos;re gonna want to see this.</Text></Paragraph>
<Paragraph Type="Character"><Text>ANNA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>What is it? Tell me now, because I have been up since four and I am not walking onto that boat without knowing what I am walking onto.</Text></Paragraph>
<Paragraph Type="Character"><Text>COP #2</Text></Paragraph>
<Paragraph Type="Parenthetical"><Text>(beat)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>It&apos;s Mrs. O&apos;Neil&apos;s boy.</Text></Paragraph>
<Paragraph Type="Character"><Text>MRS. O&apos;NEIL (O.S.)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Where is he?</Text></Paragraph>
<Paragraph Type="Action"><Text>Anna turns. MRS. O&apos;NEIL, 60s, in a nightgown and boots, at the end of the pier.</Text></Paragraph>
<Paragraph Type="Character"><Text>ANNA</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Ma&apos;am, stay there.</Text></Paragraph>
<Paragraph Number="3" Type="Scene Heading"><Text>INT./EXT. ANNA&apos;S CAR - MOVING - LATER</Text></Paragraph>
<Paragraph Type="Action"><Text>Anna drives. The wipers can&apos;t keep up.</Text></Paragraph>
<Paragraph Type="Character"><Text>ANNA</Text></Paragraph>
<Paragraph Type="Parenthetical"><Text>(into phone)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>Dell. It&apos;s the O&apos;Neil kid. Call his mother&apos;s priest.</Text></Paragraph>
<Paragraph Type="Character"><Text>MR. DELL (V.O.)</Text></Paragraph>
<Paragraph Type="Dialogue"><Text>I&apos;ll call him.</Text></Paragraph>
<Paragraph Type="Transition"><Text>FADE OUT.</Text></Paragraph>
</Content>
<TitlePage><Content><Paragraph><Text>LOW TIDE</Text></Paragraph></Content></TitlePage>
</FinalDraft>
